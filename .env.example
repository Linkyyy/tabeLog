# Local development: no account or credentials needed. Never use local mode on Vercel.
STORAGE_MODE=local
# LOCAL_DATA_DIR=/absolute/path/to/private/data

# Production: remove STORAGE_MODE=local (or change it to cloudflare).
# All values below are SERVER ONLY. Configure secrets in Vercel environment settings.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET_NAME=tabelog-photos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Single-user diary; >= 12 characters. Do not put this value in NEXT_PUBLIC_* variables.
DIARY_PASSWORD=
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional browser map keys: restrict each key to your production domains and localhost.
# Google: enable Maps JavaScript API AND Places API (New), with billing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# AMap: use a Web JS API key, with its matching securityJsCode.
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=
